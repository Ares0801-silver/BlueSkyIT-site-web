# Copier ce fichier en ".env" et renseigner de vraies valeurs.
# NE JAMAIS committer le fichier ".env" réel dans un dépôt Git.

PORT=3000

# Origine autorisée pour les requêtes CORS (URL du frontend en production)
FRONTEND_ORIGIN=http://localhost:5500

# Secret utilisé pour signer les cookies de session.
# Générer une valeur aléatoire longue, par ex avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_value

# Mettre à "true" une fois le site servi en HTTPS (obligatoire en production)
COOKIE_SECURE=false

# Environnement : development | production
NODE_ENV=development
